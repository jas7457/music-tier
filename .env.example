# Spotify App Configuration
# Get these from https://developer.spotify.com/dashboard
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
# Optional. Leave unset and the app uses <current origin>/callback, which is
# what makes preview deployments work. Set it only to force a specific URI
# (e.g. an ngrok tunnel). Whatever is used must be registered in the Spotify
# dashboard — Spotify matches redirect URIs exactly and allows no wildcards.
# NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://localhost:3000/callback

# Cron Job Secret
# Generate a random secret for securing cron endpoints
# Example: openssl rand -base64 32
CRON_SECRET=your_random_secret_here